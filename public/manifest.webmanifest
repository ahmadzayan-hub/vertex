{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "VERTEX - Contract & Project Intelligence",
  "short_name": "VERTEX",
  "description": "Upload a submission, get a compliance score and structured findings in seconds. Bilingual English and Arabic. UAE focused.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f172a",
  "theme_color": "#4338ca",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" },
    { "src": "/apple-touch-icon.svg", "sizes": "180x180", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    {
      "name": "Upload submission",
      "short_name": "Upload",
      "description": "Upload a new document for analysis",
      "url": "/upload",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open the risk dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "prefer_related_applications": false
}
