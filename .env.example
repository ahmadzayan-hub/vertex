# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Secrets stay on your machine.

# Supabase project (Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# AI provider - controls how the browser talks to the model.
#   mock       Deterministic client-side mock. Works without any keys.
#   edge       Routes analysis through the Supabase Edge Function
#              (analyze-submission). The real API keys live in
#              Supabase project secrets, not in the browser.
VITE_AI_PROVIDER=mock

# The real provider keys go in Supabase project secrets, not here.
# Do not add ANTHROPIC_API_KEY or OPENAI_API_KEY to this file - anything
# that starts with VITE_ ends up in the browser bundle.
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set AI_PROVIDER=anthropic
